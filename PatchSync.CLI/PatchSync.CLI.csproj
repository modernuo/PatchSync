<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Optimize>true</Optimize>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <!-- Font preview tool - Debug only, excluded from Release/AOT builds -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>$(DefineConstants);FONT_PREVIEW</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.0.16" />
        <!-- Figgle only needed for font preview in debug mode -->
        <PackageReference Include="Figgle" Version="0.6.5" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="Spectre.Console" Version="0.54.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.1" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.1" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PatchSync.Common\PatchSync.Common.csproj" />
        <ProjectReference Include="..\PatchSync.SDK\PatchSync.SDK.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="dev-docs\" />
    </ItemGroup>
</Project>
