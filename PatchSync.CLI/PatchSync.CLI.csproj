<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Optimize>true</Optimize>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.0.16" />
        <PackageReference Include="Spectre.Console" Version="0.54.0" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.1" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PatchSync.Common\PatchSync.Common.csproj" />
        <ProjectReference Include="..\PatchSync.SDK\PatchSync.SDK.csproj" />
    </ItemGroup>
</Project>
